# Copy to .env and edit. Only WHISPER_BASE_URL usually needs changing.

# whisper-server's address, as seen from inside the container.
# The Windows box with the GPU, by hostname or IP:
WHISPER_BASE_URL=http://192.168.1.10:8080
# ...or a whisper-server on the docker host itself:
# WHISPER_BASE_URL=http://host.docker.internal:8080

# Must match the model whisper-server was started with.
WHISPER_MODEL=large-v3-turbo-q5_0

# ISO code, or "auto" to let whisper detect it.
WHISPER_LANGUAGE=auto

# A 90-minute episode is one long blocking request until chunking lands in M2.
WHISPER_TIMEOUT_MINUTES=120

# ---- Ollama: agentic episode summaries ------------------------------------
# Optional and off by default. When on, each finished transcript is read by a local
# model and summarised: what the episode is about, the positions each speaker
# argues, where they disagree, and the claims worth remembering — each with a
# timestamp you can click to jump the player there.
#
# On the machine running Ollama:
#   OLLAMA_HOST=0.0.0.0 ollama serve     # it binds to localhost otherwise
#   ollama pull llama3.1:8b
# Then flip this on and check it from the Settings page, which tests the connection
# and tells you if the model has not been pulled.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://192.168.1.10:11434
# ...or an Ollama on the docker host itself:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Must already be pulled on that server. An 8B model is plenty for summarising and
# fits a 8-12 GB card; a 70B is better prose and far slower.
OLLAMA_MODEL=llama3.1:8b

# Summarise automatically at the end of every transcription job. False leaves it to
# the Summarize button on the episode page.
OLLAMA_AUTO_SUMMARIZE=true

# Ollama defaults num_ctx to 2048 tokens, which silently truncates the middle of
# anything episode-sized. A 90-minute episode is read in windows of WINDOW_CHARS and
# then combined, so these two move together: the window plus the answer has to fit
# inside the context. Raise both if your model and VRAM allow it.
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_WINDOW_CHARS=12000
OLLAMA_MAX_OUTPUT_TOKENS=2048

# Reasoning models — qwen3, deepseek-r1, gpt-oss — think before they answer, and Ollama
# switches that on by itself for any model that supports it. The model then spends the
# whole OLLAMA_MAX_OUTPUT_TOKENS budget inside <think> and returns an empty answer with
# an HTTP 200, which looks exactly like a broken model. Off by default, which is safe on
# every model: Ollama only objects to this field when it is set to true on a model that
# cannot think. Summarising does not benefit from reasoning anyway.
OLLAMA_THINK=false

# Low on purpose. This is summarising, not writing; higher temperatures invent.
OLLAMA_TEMPERATURE=0.2

# A long episode is several generate calls back to back, and a CPU-only Ollama is slow.
OLLAMA_TIMEOUT_MINUTES=30

# Appended to the summary instructions. Where a show-specific steer goes.
# OLLAMA_EXTRA_INSTRUCTIONS=The hosts are Alice and Bob; always say which one made a claim.

# Port the UI is published on.
APP_PORT=8080

MAX_UPLOAD_MB=2048

# ---- Authentication -------------------------------------------------------
# Required. The app refuses to start with auth enabled and no password set.
# Prefer ADMIN_PASSWORD_HASH: generate one on the Settings page, so the password
# itself never sits in this file. ADMIN_PASSWORD is the plaintext fallback.
# Set to false only when something in front of the app already authenticates.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-you-expose-this
# ADMIN_PASSWORD_HASH=pbkdf2$sha256$210000$...$...

# Set to enable POST /api/episodes, sent as the X-API-Key header. Leave unset
# and the submission API stays off entirely.
# API_KEY=

# This account is the only one defined here. Everyone else is added from the Users
# page once you are signed in, and those accounts live in the database as viewers,
# members or admins. This one stays in .env deliberately: it is the way back in when
# the database is restored from a backup that predates every other account.

# ---- Maintenance ----------------------------------------------------------
# Prune source audio once an episode has a finished transcript. Off by default:
# deleting the original is not reversible, and re-transcribing on a better model
# needs it. The prepared 16 kHz WAV is kept either way.
DELETE_SOURCE_AFTER_TRANSCRIPTION=false
DELETE_SOURCE_AFTER_DAYS=30
BACKUPS_TO_KEEP=7

# ---- File ownership -------------------------------------------------------
# The container fixes ownership of ./data and ./media on start and then runs
# unprivileged. Leave unset to use the image's own user. Set them to your host
# account (id -u / id -g) if you want to read and edit those files directly.
# PUID=1000
# PGID=1000
