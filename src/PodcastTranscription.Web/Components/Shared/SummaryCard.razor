@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Summarization
@using PodcastTranscription.Web.Services.Security

@* Everything here is a link or a form post. Summarising used to be an @onclick, which needs a
   live Blazor circuit — and without one the button did nothing at all. *@
<div class="summary-card" id="summary-card"
     data-episode="@EpisodeId" data-transcript="@TranscriptId"
     data-running="@(Run is { Finished: false } ? "true" : "false")">
    <div class="summary-titlebar">
        <span aria-hidden="true">📝</span>
        <span class="summary-title">Summary</span>
        @if (Summary is { } written)
        {
            <span class="summary-meta font-monospace" title="@Provenance(written)">@written.Model</span>
        }
        <span class="summary-actions">
            @if (Run is null or { Finished: true })
            {
                <AuthorizeView Policy="@Roles.MemberPolicy">
                    <form method="post" action="/episodes/@EpisodeId/summarize">
                        <AntiforgeryToken />
                        <input type="hidden" name="transcriptId" value="@TranscriptId" />
                        <button type="submit" class="btn btn-sm" disabled="@(!Enabled)" title="@ButtonTitle">
                            @(Summary is null ? "Summarize" : "Re-summarize")
                        </button>
                    </form>
                </AuthorizeView>
            }
        </span>
    </div>

    <div class="summary-body">
        @if (Run is { Finished: false } running)
        {
            @* Real progress, not a spinner: a long episode is read in several passes and each one
               is minutes of model time, so "part 3 of 6" is the difference between waiting and
               wondering whether it is broken. Driven by a poll, so it moves without a circuit. *@
            <div class="upload-progress-label">
                <span class="upload-hourglass" aria-hidden="true"></span>
                <span id="summary-stage">@running.Stage</span>
            </div>
            <div class="progress mt-2" role="progressbar" aria-label="Summarisation progress"
                 aria-valuenow="@running.Percent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" id="summary-bar" style="width: @running.Percent%;"></div>
            </div>
            <div class="summary-footer text-muted">
                <span id="summary-elapsed">@((int)running.Elapsed.TotalSeconds)s</span> elapsed ·
                @ModelName · this page updates itself, and the run carries on if you leave it.
            </div>
        }
        else if (Run is { Finished: true, Succeeded: false, Error: { } failure })
        {
            <div class="alert alert-danger mb-0">@failure</div>
        }
        else if (Error is { } error)
        {
            <div class="alert alert-danger mb-0">@error</div>
        }
        else if (!Enabled)
        {
            <p class="text-muted mb-0 small">
                Summaries are off. Set <code>OLLAMA_ENABLED=true</code> and
                <code>OLLAMA_BASE_URL</code> in <code>.env</code>, then restart.
            </p>
        }
        else if (Summary is null)
        {
            <p class="text-muted mb-0 small">
                No summary yet. <strong>Summarize</strong> sends this transcript to
                @ModelName for a read of what is argued in the episode and who argues it.
            </p>
        }
        else
        {
            <div class="summary-content" id="summary-body">
                @Rendered
            </div>
            <div class="summary-footer text-muted">@Provenance(Summary)</div>
        }
    </div>
</div>

@code {
    [Parameter] public Summary? Summary { get; set; }

    [Parameter, EditorRequired] public int EpisodeId { get; set; }

    [Parameter, EditorRequired] public int TranscriptId { get; set; }

    /// <summary>The run in flight, or the one that just finished. Null when none was ever started.</summary>
    [Parameter] public SummaryRun? Run { get; set; }

    /// <summary>False when Ollama is not configured, which turns the button into an explanation.</summary>
    [Parameter] public bool Enabled { get; set; }

    [Parameter] public string? Error { get; set; }

    /// <summary>The configured model, for the empty state — <see cref="Summary"/> carries its own.</summary>
    [Parameter] public string ModelName { get; set; } = "the configured model";

    /// <summary>
    /// Cached against the text it was built from: the render walks the whole summary, and this
    /// component re-renders on every job notification on the page.
    /// </summary>
    private string? _renderedFrom;
    private MarkupString _rendered;

    private MarkupString Rendered
    {
        get
        {
            var content = Summary?.Content ?? string.Empty;
            if (_renderedFrom != content)
            {
                _rendered = new MarkupString(SummaryMarkdown.ToHtml(content));
                _renderedFrom = content;
            }

            return _rendered;
        }
    }

    private string ButtonTitle => Enabled
        ? "Send this transcript to Ollama and write a summary of what the episode argues"
        : "Ollama is not configured — set Ollama__Enabled and Ollama__BaseUrl";

    private static string Provenance(Summary summary)
    {
        var parts = new List<string>
        {
            summary.Model,
            summary.WindowCount > 1 ? $"{summary.WindowCount} passes" : "one pass",
            $"{summary.DurationMs / 1000.0:N0}s",
            summary.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        };

        if (summary.PromptTokens is { } prompt and > 0)
        {
            parts.Insert(2, $"{prompt:N0} tokens in");
        }

        return string.Join(" · ", parts);
    }
}
