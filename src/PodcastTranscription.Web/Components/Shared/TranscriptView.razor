@using System.Text.Json
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services

@* Timings live in data attributes; player.js does the highlighting locally rather than over the circuit. *@
<div id="transcript-body" class="transcript @(ShadeConfidence ? "shade-confidence" : "")" data-follow="@(Follow ? "true" : "false")">
    @foreach (var segment in Segments)
    {
        @* In edit mode the line carries no timing data, so a click lands in the textbox instead
           of seeking the player. *@
        <div class="transcript-line @(segment.IsEdited ? "is-edited" : "")"
             id="segment-@segment.Id"
             data-segment="@(Editable ? null : "")"
             data-t0="@(Editable ? null : segment.StartMs.ToString())"
             data-t1="@(Editable ? null : segment.EndMs.ToString())">
            <span class="transcript-time font-monospace text-muted">@TimeFormat.Clock(segment.StartMs)</span>

            @if (Editable)
            {
                <span class="transcript-text">
                    <form method="post" action="/episodes/@EpisodeId/segments/@segment.Id"
                          class="d-flex gap-1">
                        <AntiforgeryToken />
                        <input name="text" class="form-control form-control-sm" value="@segment.Text"
                               aria-label="Segment text" />
                        <button type="submit" class="btn btn-sm">Save</button>
                    </form>
                </span>
            }
            else
            {
                <span class="transcript-text">
                    @if (ShowWords && WordsFor(segment) is { Count: > 0 } words)
                    {
                        @foreach (var word in words)
                        {
                            <span class="w @ConfidenceClass(word)" data-word data-t0="@word.StartMs" data-t1="@word.EndMs"
                                  title="@ConfidenceTitle(word)">@word.Text</span>
                            @(" ")
                        }
                    }
                    else
                    {
                        @segment.Text
                    }
                </span>
            }

            @if (segment.IsEdited)
            {
                <span class="badge bg-light text-dark align-self-center" title="Corrected by hand">edited</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Segment> Segments { get; set; } = [];

    /// <summary>Render each word separately. Off by default: an hour of audio is ~13,000 spans.</summary>
    [Parameter] public bool ShowWords { get; set; }

    [Parameter] public bool ShadeConfidence { get; set; }

    [Parameter] public bool Follow { get; set; } = true;

    /// <summary>Turns each line into a text box. Whisper mangles proper nouns; fixing them in
    /// place beats exporting and editing elsewhere.</summary>
    [Parameter] public bool Editable { get; set; }

    /// <summary>Where a correction posts back to. Required whenever <see cref="Editable"/> is set.</summary>
    [Parameter] public int EpisodeId { get; set; }

    private readonly Dictionary<int, List<TranscribedWord>> _wordCache = [];

    private List<TranscribedWord>? WordsFor(Segment segment)
    {
        if (_wordCache.TryGetValue(segment.Id, out var cached))
        {
            return cached;
        }

        if (string.IsNullOrWhiteSpace(segment.WordsJson))
        {
            return null;
        }

        try
        {
            var words = JsonSerializer.Deserialize<List<TranscribedWord>>(segment.WordsJson) ?? [];
            _wordCache[segment.Id] = words;
            return words;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>
    /// Shading bands for per-word probability. The point is to find the mangled proper nouns
    /// quickly, so only genuinely doubtful words are marked.
    /// </summary>
    private static string ConfidenceClass(TranscribedWord word) => word.Probability switch
    {
        null => string.Empty,
        < 0.45 => "conf-low",
        < 0.70 => "conf-mid",
        _ => string.Empty
    };

    private static string? ConfidenceTitle(TranscribedWord word) =>
        word.Probability is { } p ? $"{p:P0} confidence" : null;
}
