@page "/upload"
@using Microsoft.AspNetCore.Components.Endpoints
@using PodcastTranscription.Web.Services
@* Rendered statically so the forms are ordinary browser posts. Uploading a 2 GB episode over the
   SignalR circuit would be slow, and would fail silently whenever the circuit has not connected. *@
@attribute [ExcludeFromInteractiveRouting]
@inject MediaStore Media

<PageTitle>Add episode</PageTitle>

<h1 class="h3 mb-3">Add episode</h1>

<div class="row">
    <div class="col-lg-7">
        @if (Error is not null)
        {
            <div class="alert alert-danger">@Error</div>
        }

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(IsUrlTab ? "" : "active")" href="/upload">Upload a file</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(IsUrlTab ? "active" : "")" href="/upload?tab=url">From a URL</a>
            </li>
        </ul>

        @if (IsUrlTab)
        {
            <form method="post" action="/upload/url">
                <AntiforgeryToken />

                <div class="mb-3">
                    <label class="form-label" for="url-title">Title <span class="text-muted">(optional)</span></label>
                    <input id="url-title" name="title" class="form-control" placeholder="Defaults to what yt-dlp reports" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="url-show">Show <span class="text-muted">(optional)</span></label>
                    <input id="url-show" name="show" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="url">Episode URL</label>
                    <input id="url" name="url" class="form-control" required
                           placeholder="https://example.com/episode.mp3" />
                    <div class="form-text">
                        Downloaded with yt-dlp, so a direct audio link or a page it recognises both work.
                        The download happens in the job queue — you do not have to wait here.
                    </div>
                </div>

                <button class="btn btn-primary" type="submit">Fetch and transcribe</button>
            </form>
        }
        else
        {
            <form method="post" action="/upload/file" enctype="multipart/form-data">
                <AntiforgeryToken />

                <div class="mb-3">
                    <label class="form-label" for="title">Title <span class="text-muted">(optional)</span></label>
                    <input id="title" name="title" class="form-control" placeholder="Defaults to the file name" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="show">Show <span class="text-muted">(optional)</span></label>
                    <input id="show" name="show" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="file">Audio file</label>
                    <input id="file" name="file" type="file" class="form-control" required
                           accept="audio/*,video/*,.mp3,.m4a,.wav,.flac,.ogg,.opus,.aac,.mp4,.mkv" />
                    <div class="form-text">
                        Anything ffmpeg can decode. Up to @TimeFormat.Size(Media.MaxUploadBytes).
                    </div>
                </div>

                <button class="btn btn-primary" type="submit">Upload and transcribe</button>
                <div class="form-text mt-2">
                    Large files take a while to upload — the page stays here until the transfer finishes.
                </div>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }

    private bool IsUrlTab => string.Equals(Tab, "url", StringComparison.OrdinalIgnoreCase);
}
