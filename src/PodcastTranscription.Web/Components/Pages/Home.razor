@page "/"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Search
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SearchService Search

<PageTitle>Library</PageTitle>

<div class="library-heading d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Library</h1>
    <div class="library-heading-actions">
        <a class="btn btn-primary library-add-episode" href="/upload">Add episode</a>
        <details class="library-filter-popout">
            <summary aria-label="Open library filters" title="Filter library">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 5h18l-7 8v5l-4 2v-7L3 5z"></path>
                </svg>
            </summary>
            <div class="library-filter-panel">
                <div class="library-filter-title">filter library</div>
                <form method="get" action="/" class="library-filter-form">
                    <div>
                        <label class="form-label small mb-1" for="pwa-filter-title">Title</label>
                        <input id="pwa-filter-title" class="form-control form-control-sm"
                               placeholder="Filter by title" name="title" value="@_titleFilter" />
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="pwa-filter-show">Show</label>
                        <select id="pwa-filter-show" name="show" class="form-select form-select-sm">
                            <option value="" selected="@(_showFilter.Length == 0)">All shows</option>
                            @foreach (var show in _shows)
                            {
                                <option value="@show" selected="@(show == _showFilter)">@show</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="pwa-filter-state">State</label>
                        <select id="pwa-filter-state" name="state" class="form-select form-select-sm">
                            @foreach (var (value, label) in States)
                            {
                                <option value="@value" selected="@(value == _stateFilter)">@label</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-1" for="pwa-sort-by">Sort</label>
                        <select id="pwa-sort-by" name="sort" class="form-select form-select-sm">
                            @foreach (var (value, label) in Sorts)
                            {
                                <option value="@value" selected="@(value == _sort)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="library-filter-actions">
                        <button type="submit" class="btn btn-sm">Apply filters</button>
                        <a href="/" class="btn btn-sm">Clear</a>
                    </div>
                </form>
            </div>
        </details>
    </div>
</div>

<form method="get" action="/" class="desktop-library-filters row g-2 align-items-end mb-3" id="library-filters">
    <div class="col-md-4">
        <label class="form-label small mb-1" for="filter-title">Title</label>
        <input id="filter-title" class="form-control form-control-sm" placeholder="Filter by title"
               name="title" value="@_titleFilter" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="filter-show">Show</label>
        <select id="filter-show" name="show" class="form-select form-select-sm">
            <option value="" selected="@(_showFilter.Length == 0)">All shows</option>
            @foreach (var show in _shows)
            {
                <option value="@show" selected="@(show == _showFilter)">@show</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1" for="filter-state">State</label>
        <select id="filter-state" name="state" class="form-select form-select-sm">
            @foreach (var (value, label) in States)
            {
                <option value="@value" selected="@(value == _stateFilter)">@label</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1" for="sort-by">Sort</label>
        <select id="sort-by" name="sort" class="form-select form-select-sm">
            @foreach (var (value, label) in Sorts)
            {
                <option value="@value" selected="@(value == _sort)">@label</option>
            }
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-sm w-100">Filter</button>
    </div>
</form>

@if (DeleteError is not null)
{
    <div class="alert alert-warning py-2">@DeleteError</div>
}

@if (_episodes is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_episodes.Count == 0)
{
    <p class="text-muted">
        @(_total == 0
            ? "Nothing here yet."
            : "No episodes match those filters.")
        <a href="/upload">Upload an episode</a> to get started.
    </p>
}
else
{
    <div class="library-table table-wrap">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Show</th>
                <th class="text-end">Duration</th>
                <th class="added-column">Added</th>
                <th>State</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _episodes)
            {
                <tr>
                    <td><a href="/episodes/@row.Episode.Id" class="text-decoration-none">@row.Episode.Title</a></td>
                    <td class="text-muted">@(row.Episode.Show ?? "—")</td>
                    <td class="text-end font-monospace">@TimeFormat.Duration(row.Episode.DurationSec)</td>
                    <td class="added-column text-muted">@row.Episode.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (row.LatestJobState is { } state && JobDisplay.IsActive(state))
                        {
                            <span class="badge @JobDisplay.BadgeClass(state)">@state</span>
                        }
                        else if (row.HasSummary)
                        {
                            <span class="badge bg-success">summary</span>
                        }
                        else if (row.TranscriptCount > 0)
                        {
                            <span class="badge bg-success">@row.TranscriptCount transcript@(row.TranscriptCount == 1 ? "" : "s")</span>
                        }
                        else if (row.LatestJobState == JobState.Failed)
                        {
                            <span class="badge bg-danger">Failed</span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary me-1" href="/episodes/@row.Episode.Id">Open</a>
                        <a class="btn btn-sm" href="/delete/episode/@row.Episode.Id"
                           title="Delete this episode, its transcripts and its audio">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="pwa-library-list">
        @foreach (var row in _episodes)
        {
            <article class="pwa-library-card">
                <a class="pwa-library-title" href="/episodes/@row.Episode.Id">@row.Episode.Title</a>
                <div class="pwa-library-meta">
                    <span>@(row.Episode.Show ?? "No show")</span>
                    <span>@TimeFormat.Duration(row.Episode.DurationSec)</span>
                    <span>@StateLabel(row)</span>
                </div>
                <p class="pwa-library-preview">@Preview(row)</p>
                <div class="pwa-library-footer">
                    <div class="pwa-library-actions">
                        <a class="btn btn-sm" href="/episodes/@row.Episode.Id">Open</a>
                        <a class="btn btn-sm" href="/delete/episode/@row.Episode.Id"
                           title="Delete this episode, its transcripts and its audio">Delete</a>
                    </div>
                    <time datetime="@row.Episode.CreatedAt.ToString("O")">
                        @row.Episode.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </time>
                </div>
            </article>
        }
    </div>

    @if (_pageCount > 1)
    {
        <nav aria-label="Library pages">
            <ul class="pagination pagination-sm">
                <li class="page-item @(_page == 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(_page - 1)">Previous</a>
                </li>
                @foreach (var number in PageNumbers())
                {
                    <li class="page-item @(number == _page ? "active" : "")">
                        <a class="page-link" href="@PageLink(number)">@number</a>
                    </li>
                }
                <li class="page-item @(_page == _pageCount ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(_page + 1)">Next</a>
                </li>
            </ul>
        </nav>
        <p class="text-muted small">@_total episodes</p>
    }
}

@code {
    private const int PageSize = 25;

    private record Row(
        Episode Episode,
        int TranscriptCount,
        bool HasSummary,
        JobState? LatestJobState,
        string? SummaryText,
        string? TranscriptText);

    /// <summary>A refusal handed back by the delete endpoint, e.g. a job still running.</summary>
    [SupplyParameterFromQuery(Name = "error")] private string? DeleteError { get; set; }

    private static readonly (string Value, string Label)[] States =
    [
        ("", "Any"),
        ("transcribed", "Transcribed"),
        ("summary", "Summary"),
        ("none", "No transcript"),
        ("running", "In progress"),
        ("failed", "Failed")
    ];

    private static readonly (string Value, string Label)[] Sorts =
    [
        ("added-desc", "Newest first"),
        ("added-asc", "Oldest first"),
        ("title", "Title"),
        ("duration-desc", "Longest first")
    ];

    private List<Row>? _episodes;
    private List<string> _shows = [];

    /// <summary>
    /// Filters, sort and page all live in the query string. They used to be bound fields updated
    /// by change handlers, which need a live Blazor circuit — so where the circuit does not
    /// connect the filters silently did nothing. As URL state they work without one, and a
    /// filtered library is a link you can keep.
    /// </summary>
    [SupplyParameterFromQuery(Name = "title")] private string? _titleFilter { get; set; }

    [SupplyParameterFromQuery(Name = "show")] private string? _showQuery { get; set; }

    [SupplyParameterFromQuery(Name = "state")] private string? _stateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sort")] private string? _sortQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")] private int? _pageQuery { get; set; }

    private string _showFilter => _showQuery ?? string.Empty;
    private string _stateFilter => _stateQuery ?? string.Empty;
    private string _sort => _sortQuery ?? "added-desc";

    private int _page = 1;
    private int _total;
    private int _pageCount = 1;

    /// <summary>Keeps the current filters while changing only the page.</summary>
    private string PageLink(int page)
    {
        var parts = new List<string>();

        void Add(string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                parts.Add($"{key}={Uri.EscapeDataString(value)}");
            }
        }

        Add("title", _titleFilter);
        Add("show", _showQuery);
        Add("state", _stateQuery);
        Add("sort", _sortQuery);

        var clamped = Math.Clamp(page, 1, Math.Max(1, _pageCount));
        if (clamped > 1)
        {
            parts.Add($"page={clamped}");
        }

        return parts.Count == 0 ? "/" : "/?" + string.Join("&", parts);
    }

    protected override async Task OnParametersSetAsync()
    {
        _shows = await Search.GetShowsAsync();
        _page = Math.Max(1, _pageQuery ?? 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Episodes.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(_titleFilter))
        {
            var term = _titleFilter.Trim();
            query = query.Where(e => EF.Functions.Like(e.Title, $"%{term}%"));
        }

        if (!string.IsNullOrWhiteSpace(_showFilter))
        {
            query = query.Where(e => e.Show == _showFilter);
        }

        // State is derived from transcripts and jobs rather than stored on the episode, so it
        // filters as a subquery rather than a column.
        query = _stateFilter switch
        {
            "transcribed" => query.Where(e =>
                e.Transcripts.Any() && !e.Transcripts.Any(t => t.Summary != null)),
            "summary" => query.Where(e => e.Transcripts.Any(t => t.Summary != null)),
            "none" => query.Where(e => !e.Transcripts.Any()),
            "running" => query.Where(e => e.Jobs.Any(j =>
                j.State == JobState.Queued || j.State == JobState.Downloading
                || j.State == JobState.Preparing || j.State == JobState.Transcribing
                || j.State == JobState.Summarizing)),
            "failed" => query.Where(e => e.Jobs.Any(j => j.State == JobState.Failed)),
            _ => query
        };

        query = _sort switch
        {
            "added-asc" => query.OrderBy(e => e.CreatedAt),
            "title" => query.OrderBy(e => e.Title),
            "duration-desc" => query.OrderByDescending(e => e.DurationSec ?? 0),
            _ => query.OrderByDescending(e => e.CreatedAt)
        };

        _total = await query.CountAsync();
        _pageCount = Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));
        _page = Math.Clamp(_page, 1, _pageCount);

        _episodes = await query
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .Select(e => new Row(
                e,
                e.Transcripts.Count(),
                e.Transcripts.Any(t => t.Summary != null),
                e.Jobs.OrderByDescending(j => j.CreatedAt).Select(j => (JobState?)j.State).FirstOrDefault(),
                e.Transcripts
                    .Where(t => t.Summary != null)
                    .OrderByDescending(t => t.Summary!.CreatedAt)
                    .Select(t => t.Summary!.Content)
                    .FirstOrDefault(),
                e.Transcripts
                    .OrderByDescending(t => t.CreatedAt)
                    .SelectMany(t => t.Segments.OrderBy(s => s.Ordinal))
                    .Select(s => s.Text)
                    .FirstOrDefault()))
            .ToListAsync();
    }

    private static string StateLabel(Row row)
    {
        if (row.LatestJobState is { } state && JobDisplay.IsActive(state))
        {
            return state.ToString();
        }

        return row.HasSummary ? "Summary"
            : row.TranscriptCount > 0 ? $"{row.TranscriptCount} transcript{(row.TranscriptCount == 1 ? "" : "s")}"
            : row.LatestJobState == JobState.Failed ? "Failed"
            : "No transcript";
    }

    private static string Preview(Row row)
    {
        var source = row.SummaryText ?? row.TranscriptText;
        if (string.IsNullOrWhiteSpace(source))
        {
            return "No summary or transcript yet.";
        }

        return string.Join(" ", source
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.TrimStart('#', '-', '*', ' ')))
            .Trim();
    }

    /// <summary>A window of page numbers around the current one, so 400 episodes is not 16 links.</summary>
    private IEnumerable<int> PageNumbers()
    {
        var first = Math.Max(1, _page - 2);
        var last = Math.Min(_pageCount, first + 4);
        first = Math.Max(1, last - 4);

        for (var number = first; number <= last; number++)
        {
            yield return number;
        }
    }
}
