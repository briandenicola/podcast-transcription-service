@page "/"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Search
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SearchService Search
@inject DeletionService Deletion
@inject WhisperClient Whisper

<PageTitle>Library</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Library</h1>
    <a class="btn btn-primary" href="/upload">Add episode</a>
</div>

<div class="alert @WhisperAlertClass d-flex justify-content-between align-items-center py-2">
    <span>
        <strong>whisper-server</strong>
        <code class="ms-1">@Whisper.Endpoint</code>
        <span class="ms-2 text-muted">model @Whisper.Model</span>
    </span>
    <span>@WhisperStatusText</span>
</div>

<div class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label small mb-1" for="filter-title">Title</label>
        <input id="filter-title" class="form-control form-control-sm" placeholder="Filter by title"
               @bind="_titleFilter" @bind:event="oninput" @bind:after="ApplyFilters" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="filter-show">Show</label>
        <select id="filter-show" class="form-select form-select-sm" @bind="_showFilter" @bind:after="ApplyFilters">
            <option value="">All shows</option>
            @foreach (var show in _shows)
            {
                <option value="@show">@show</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1" for="filter-state">State</label>
        <select id="filter-state" class="form-select form-select-sm" @bind="_stateFilter" @bind:after="ApplyFilters">
            <option value="">Any</option>
            <option value="transcribed">Transcribed</option>
            <option value="none">No transcript</option>
            <option value="running">In progress</option>
            <option value="failed">Failed</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1" for="sort-by">Sort</label>
        <select id="sort-by" class="form-select form-select-sm" @bind="_sort" @bind:after="ApplyFilters">
            <option value="added-desc">Newest first</option>
            <option value="added-asc">Oldest first</option>
            <option value="title">Title</option>
            <option value="duration-desc">Longest first</option>
        </select>
    </div>
</div>

@if (_message is not null)
{
    <div class="alert alert-warning py-2">@_message</div>
}

@if (_episodes is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_episodes.Count == 0)
{
    <p class="text-muted">
        @(_total == 0
            ? "Nothing here yet."
            : "No episodes match those filters.")
        <a href="/upload">Upload an episode</a> to get started.
    </p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Show</th>
                <th class="text-end">Duration</th>
                <th>Added</th>
                <th>State</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _episodes)
            {
                <tr>
                    <td><a href="/episodes/@row.Episode.Id" class="text-decoration-none">@row.Episode.Title</a></td>
                    <td class="text-muted">@(row.Episode.Show ?? "—")</td>
                    <td class="text-end font-monospace">@TimeFormat.Duration(row.Episode.DurationSec)</td>
                    <td class="text-muted">@row.Episode.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (row.LatestJobState is { } state && JobDisplay.IsActive(state))
                        {
                            <span class="badge @JobDisplay.BadgeClass(state)">@state</span>
                        }
                        else if (row.TranscriptCount > 0)
                        {
                            <span class="badge bg-success">@row.TranscriptCount transcript@(row.TranscriptCount == 1 ? "" : "s")</span>
                        }
                        else if (row.LatestJobState == JobState.Failed)
                        {
                            <span class="badge bg-danger">Failed</span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary me-1" href="/episodes/@row.Episode.Id">Open</a>
                        <ConfirmButton Text="Delete"
                                       ConfirmText="Delete episode and audio"
                                       Title="Delete this episode, its transcripts and its audio"
                                       ConfirmTitle="Removes the audio too — this cannot be undone"
                                       OnConfirmed="() => DeleteEpisode(row.Episode.Id)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_pageCount > 1)
    {
        <nav aria-label="Library pages">
            <ul class="pagination pagination-sm">
                <li class="page-item @(_page == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(_page - 1)">Previous</button>
                </li>
                @foreach (var number in PageNumbers())
                {
                    <li class="page-item @(number == _page ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(number)">@number</button>
                    </li>
                }
                <li class="page-item @(_page == _pageCount ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(_page + 1)">Next</button>
                </li>
            </ul>
        </nav>
        <p class="text-muted small">@_total episodes</p>
    }
}

@code {
    private const int PageSize = 25;

    private record Row(Episode Episode, int TranscriptCount, JobState? LatestJobState);

    private List<Row>? _episodes;
    private List<string> _shows = [];
    private WhisperHealth? _whisperHealth;
    private string? _message;

    private string WhisperAlertClass => _whisperHealth switch
    {
        { Ready: true } => "alert-success",
        { ModelLoading: true } => "alert-info",
        _ => "alert-warning"
    };

    private string WhisperStatusText => _whisperHealth switch
    {
        { Ready: true } => "reachable",
        { ModelLoading: true } => "loading model — the queue is waiting",
        _ => "unreachable"
    };

    private string? _titleFilter;
    private string _showFilter = string.Empty;
    private string _stateFilter = string.Empty;
    private string _sort = "added-desc";

    private int _page = 1;
    private int _total;
    private int _pageCount = 1;

    protected override async Task OnInitializedAsync()
    {
        _shows = await Search.GetShowsAsync();
        _whisperHealth = await Whisper.CheckHealthAsync();
        await LoadAsync();
    }

    private async Task DeleteEpisode(int episodeId)
    {
        var result = await Deletion.DeleteEpisodeAsync(episodeId);
        _message = result.Refusal;
        await LoadAsync();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        _page = Math.Clamp(page, 1, Math.Max(1, _pageCount));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Episodes.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(_titleFilter))
        {
            var term = _titleFilter.Trim();
            query = query.Where(e => EF.Functions.Like(e.Title, $"%{term}%"));
        }

        if (!string.IsNullOrWhiteSpace(_showFilter))
        {
            query = query.Where(e => e.Show == _showFilter);
        }

        // State is derived from transcripts and jobs rather than stored on the episode, so it
        // filters as a subquery rather than a column.
        query = _stateFilter switch
        {
            "transcribed" => query.Where(e => e.Transcripts.Any()),
            "none" => query.Where(e => !e.Transcripts.Any()),
            "running" => query.Where(e => e.Jobs.Any(j =>
                j.State == JobState.Queued || j.State == JobState.Downloading
                || j.State == JobState.Preparing || j.State == JobState.Transcribing)),
            "failed" => query.Where(e => e.Jobs.Any(j => j.State == JobState.Failed)),
            _ => query
        };

        query = _sort switch
        {
            "added-asc" => query.OrderBy(e => e.CreatedAt),
            "title" => query.OrderBy(e => e.Title),
            "duration-desc" => query.OrderByDescending(e => e.DurationSec ?? 0),
            _ => query.OrderByDescending(e => e.CreatedAt)
        };

        _total = await query.CountAsync();
        _pageCount = Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));
        _page = Math.Clamp(_page, 1, _pageCount);

        _episodes = await query
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .Select(e => new Row(
                e,
                e.Transcripts.Count(),
                e.Jobs.OrderByDescending(j => j.CreatedAt).Select(j => (JobState?)j.State).FirstOrDefault()))
            .ToListAsync();
    }

    /// <summary>A window of page numbers around the current one, so 400 episodes is not 16 links.</summary>
    private IEnumerable<int> PageNumbers()
    {
        var first = Math.Max(1, _page - 2);
        var last = Math.Min(_pageCount, first + 4);
        first = Math.Max(1, last - 4);

        for (var number = first; number <= last; number++)
        {
            yield return number;
        }
    }
}
