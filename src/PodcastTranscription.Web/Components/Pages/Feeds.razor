@page "/feeds"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services.Ingest
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FeedService Subscriptions
@inject ILogger<Feeds> Log

<PageTitle>Feeds</PageTitle>

<h1 class="h3 mb-3">Feeds</h1>

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label" for="rss-url">Subscribe to a podcast</label>
        <div class="input-group">
            <input id="rss-url" class="form-control" placeholder="https://example.com/feed.xml"
                   @bind="_rssUrl" disabled="@_busy" />
            <button class="btn btn-primary" @onclick="Subscribe" disabled="@_busy">Subscribe</button>
        </div>
        <div class="form-text">
            Episodes already in the feed are recorded but not queued. Use Backfill on a feed to
            transcribe history deliberately.
        </div>

        @if (_message is not null)
        {
            <div class="alert @(_failed ? "alert-danger" : "alert-success") mt-3 mb-0 py-2">@_message</div>
        }
    </div>
</div>

@if (_feeds is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_feeds.Count == 0)
{
    <p class="text-muted">No subscriptions yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Feed</th>
                <th class="text-end">Episodes</th>
                <th>Auto-transcribe</th>
                <th>Last polled</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _feeds)
            {
                <tr>
                    <td>
                        <a href="/feeds/@row.Feed.Id" class="text-decoration-none fw-semibold">@row.Feed.Title</a>
                        <div class="small text-muted text-break">@row.Feed.RssUrl</div>
                        @if (row.Feed.LastError is not null)
                        {
                            <div class="small text-danger">@row.Feed.LastError</div>
                        }
                    </td>
                    <td class="text-end">@row.EpisodeCount</td>
                    <td>
                        @if (row.Feed.AutoTranscribe)
                        {
                            <span class="badge bg-success">On</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Off</span>
                        }
                    </td>
                    <td class="text-muted small">
                        @(row.Feed.LastPolledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/feeds/@row.Feed.Id">Open</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private record Row(Feed Feed, int EpisodeCount);

    private List<Row>? _feeds;
    private string? _rssUrl;
    private string? _message;
    private bool _busy;
    private bool _failed;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _feeds = await db.Feeds
            .OrderBy(f => f.Title)
            .Select(f => new Row(f, f.Episodes.Count()))
            .ToListAsync();
    }

    private async Task Subscribe()
    {
        if (string.IsNullOrWhiteSpace(_rssUrl))
        {
            return;
        }

        _busy = true;
        _failed = false;
        _message = "Fetching the feed…";

        try
        {
            var feed = await Subscriptions.SubscribeAsync(_rssUrl.Trim());
            _message = $"Subscribed to {feed.Title}.";
            _rssUrl = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Subscribing to {Url} failed", _rssUrl);
            _failed = true;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
