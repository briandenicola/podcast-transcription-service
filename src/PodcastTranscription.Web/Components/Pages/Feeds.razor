@page "/feeds"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services.Ingest
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FeedService Subscriptions
@inject ILogger<Feeds> Log

<PageTitle>Feeds</PageTitle>

<h1 class="h3 mb-3">Feeds</h1>

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label" for="rss-url">Subscribe to a podcast</label>
        <form method="post" action="/feeds/subscribe" class="input-group">
            <AntiforgeryToken />
            <input id="rss-url" name="rssUrl" class="form-control"
                   placeholder="https://example.com/feed.xml" />
            <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
        <div class="form-text">
            Episodes already in the feed are recorded but not queued. Use Backfill on a feed to
            transcribe history deliberately.
        </div>

        @if (Message is { } message)
        {
            <div class="alert @(Failed ? "alert-danger" : "alert-success") mt-3 mb-0 py-2">@message</div>
        }
    </div>
</div>

@if (_feeds is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_feeds.Count == 0)
{
    <p class="text-muted">No subscriptions yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Feed</th>
                <th class="text-end">Episodes</th>
                <th>Auto-transcribe</th>
                <th>Last polled</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _feeds)
            {
                <tr>
                    <td>
                        <a href="/feeds/@row.Feed.Id" class="text-decoration-none fw-semibold">@row.Feed.Title</a>
                        <div class="small text-muted text-break">@row.Feed.RssUrl</div>
                        @if (row.Feed.LastError is not null)
                        {
                            <div class="small text-danger">@row.Feed.LastError</div>
                        }
                    </td>
                    <td class="text-end">@row.EpisodeCount</td>
                    <td>
                        @if (row.Feed.AutoTranscribe)
                        {
                            <span class="badge bg-success">On</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Off</span>
                        }
                    </td>
                    <td class="text-muted small">
                        @(row.Feed.LastPolledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/feeds/@row.Feed.Id">Open</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private record Row(Feed Feed, int EpisodeCount);

    private List<Row>? _feeds;

    /// <summary>
    /// Subscribing is a form post (see ActionEndpoints), so its outcome comes back in the query
    /// string rather than in component state.
    /// </summary>
    private string? Message => Query("notice") ?? Query("error");

    private bool Failed => Query("error") is not null;

    private string? Query(string key) =>
        QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue(key, out var value)
            ? value.ToString()
            : null;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _feeds = await db.Feeds
            .OrderBy(f => f.Title)
            .Select(f => new Row(f, f.Episodes.Count()))
            .ToListAsync();
    }
}
