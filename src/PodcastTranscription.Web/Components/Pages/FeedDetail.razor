@page "/feeds/{FeedId:int}"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Configuration
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Ingest
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.WebUtilities
@using PodcastTranscription.Web.Services.Security
@inject NavigationManager Navigation
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FeedService Feeds
@inject IOptions<IngestOptions> IngestSettings
@inject PushoverNotifier Pushover

<PageTitle>@(_feed?.Title ?? "Feed")</PageTitle>

@if (_feed is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@_feed.Title</h1>
            <div class="text-muted small text-break">@_feed.RssUrl</div>
        </div>
        <div class="text-end">
            <AuthorizeView Policy="@Roles.MemberPolicy">
                <form method="post" action="/feeds/@FeedId/poll">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary">Poll now</button>
                </form>
            </AuthorizeView>
        </div>
    </div>

    @if (Message is { } message)
    {
        <div class="alert @(Failed ? "alert-danger" : "alert-info") py-2">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header py-2 fw-semibold">Per-show defaults</div>
                <div class="card-body">
                    <p class="small text-muted">
                        Inherited by every episode this feed produces. The prompt is the cheapest
                        accuracy win available — put the host and regular guest names in it, plus
                        any jargon whisper keeps mangling.
                    </p>

                    <form method="post" action="/feeds/@FeedId/defaults">
                        <AntiforgeryToken />
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="auto-transcribe"
                                   name="autoTranscribe" checked="@_feed.AutoTranscribe" />
                            <label class="form-check-label" for="auto-transcribe">
                                Transcribe new episodes automatically
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="notify-pushover"
                                   name="notifyPushover" checked="@_feed.NotifyPushover" />
                            <label class="form-check-label" for="notify-pushover">
                                Notify via Pushover when episodes are transcribed and summarised
                            </label>
                            @if (!_pushoverConfigured)
                            {
                                <div class="form-text">
                                    Set up the Pushover app token and user key on the <a href="/settings">Settings</a>
                                    page first, or notifications will not go anywhere.
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="default-language">Language</label>
                            <input id="default-language" name="language" class="form-control"
                                   value="@_feed.DefaultLanguage" placeholder="auto" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="default-prompt">Prompt</label>
                            <textarea id="default-prompt" name="prompt" class="form-control" rows="3"
                                      placeholder="Kara Swisher, Scott Galloway, Pivot, EBITDA">@_feed.DefaultPrompt</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header py-2 fw-semibold">Backfill</div>
                <div class="card-body">
                    <p class="small text-muted mb-2">
                        Polling only takes new episodes. This queues the most recent recorded
                        episodes that have never been transcribed.
                    </p>
                    <form method="post" action="/feeds/@FeedId/backfill" class="input-group">
                        <AntiforgeryToken />
                        <input type="number" name="count" min="1" max="500" class="form-control" value="5" />
                        <button type="submit" class="btn btn-outline-primary">Queue</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <h2 class="h5">Episodes <span class="text-muted fw-normal">(@_episodes.Count)</span></h2>
            @if (_episodes.Count == 0)
            {
                <p class="text-muted">Nothing recorded from this feed yet.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var row in _episodes)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           href="/episodes/@row.Episode.Id">
                            <span>
                                @row.Episode.Title
                                <div class="small text-muted">
                                    @(row.Episode.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "no date")
                                    · @TimeFormat.Duration(row.Episode.DurationSec)
                                </div>
                            </span>
                            <span>
                                @if (row.TranscriptCount > 0)
                                {
                                    <span class="badge bg-success">transcribed</span>
                                }
                                else if (row.LatestJobState is { } state)
                                {
                                    <span class="badge @JobDisplay.BadgeClass(state)">@state</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">recorded</span>
                                }
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int FeedId { get; set; }

    private record Row(Episode Episode, int TranscriptCount, JobState? LatestJobState);

    private Feed? _feed;
    private List<Row> _episodes = [];
    private bool _pushoverConfigured;

    /// <summary>
    /// Polling, saving defaults and backfilling are all form posts now (see ActionEndpoints),
    /// so their outcome arrives in the query string. The form fields render straight from the
    /// feed rather than from mirrored component state, which also means a failed save cannot
    /// leave the page showing something that was never written.
    /// </summary>
    private string? Message => Query("notice") ?? Query("error");

    private bool Failed => Query("error") is not null;

    private string? Query(string key) =>
        QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue(key, out var value)
            ? value.ToString()
            : null;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _feed = await db.Feeds.FirstOrDefaultAsync(f => f.Id == FeedId);
        if (_feed is null)
        {
            return;
        }

        _pushoverConfigured = await Pushover.IsConfiguredAsync();

        _episodes = await db.Episodes
            .Where(e => e.FeedId == FeedId)
            .OrderByDescending(e => e.PublishedAt ?? e.CreatedAt)
            .Take(100)
            .Select(e => new Row(
                e,
                e.Transcripts.Count(),
                e.Jobs.OrderByDescending(j => j.CreatedAt).Select(j => (JobState?)j.State).FirstOrDefault()))
            .ToListAsync();
    }
}
