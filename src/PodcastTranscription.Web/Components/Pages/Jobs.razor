@page "/jobs"
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Security
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject JobNotifier Notifier

<PageTitle>Jobs</PageTitle>

<div class="jobs-heading d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Jobs</h1>
    <details class="library-filter-popout jobs-filter-popout">
        <summary aria-label="Open job filters" title="Filter jobs">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 5h18l-7 8v5l-4 2v-7L3 5z"></path>
            </svg>
        </summary>
        <div class="library-filter-panel">
            <div class="library-filter-title">filter jobs</div>
            <form method="get" action="/jobs" class="library-filter-form">
                <div>
                    <label class="form-label small mb-1" for="job-state">State</label>
                    <select id="job-state" name="state" class="form-select form-select-sm">
                        @foreach (var (value, label) in StateFilters)
                        {
                            <option value="@value" selected="@(value == _stateFilter)">@label</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1" for="job-sort">Sort</label>
                    <select id="job-sort" name="sort" class="form-select form-select-sm">
                        <option value="newest" selected="@(_sort == "newest")">Newest first</option>
                        <option value="oldest" selected="@(_sort == "oldest")">Oldest first</option>
                    </select>
                </div>
                <div class="library-filter-actions">
                    <button type="submit" class="btn btn-sm">Apply filters</button>
                    <a href="/jobs" class="btn btn-sm">Clear</a>
                </div>
            </form>
        </div>
    </details>
</div>

@if (DeleteError is not null)
{
    <div class="alert alert-warning py-2">@DeleteError</div>
}

@if (_jobs is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_jobs.Count == 0)
{
    <p class="text-muted">
        @(_stateFilter == "all" ? "Nothing queued." : "No jobs match that filter.")
        <a href="/upload">Add an episode</a>.
    </p>
}
else
{
    <div class="jobs-table table-wrap">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Episode</th>
                <th>Requested by</th>
                <th>State</th>
                <th style="width: 18rem;">Progress</th>
                <th class="text-end">Elapsed</th>
                <th class="text-end">Realtime</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in _jobs)
            {
                <tr>
                    <td>
                        <a href="/episodes/@job.EpisodeId">@(job.Episode?.Title ?? $"Episode {job.EpisodeId}")</a>
                        @if (job.Kind == JobKind.Summarization)
                        {
                            <span class="badge bg-light text-dark ms-1">summarize</span>
                        }
                        @if (job.Attempts > 1)
                        {
                            <span class="badge bg-light text-dark ms-1">attempt @job.Attempts</span>
                        }
                        @if (job.LastError is not null)
                        {
                            @* ffmpeg and whisper errors run to dozens of lines. Shown in full they
                               swamp the row and squeeze every other column out of the table. *@
                            <div class="job-error small text-danger" title="@job.LastError">@job.LastError</div>
                        }
                        @if (job.NextAttemptAt is { } next && job.State == JobState.Queued)
                        {
                            <div class="small text-muted">retrying at @next.ToLocalTime().ToString("HH:mm:ss")</div>
                        }
                    </td>
                    <td class="small">
                        @* Blank for work nobody asked for: a feed poll, or the submission API. *@
                        @(job.QueuedBy ?? "—")
                    </td>
                    <td><span class="badge @JobDisplay.BadgeClass(job.State)">@job.State</span></td>
                    <td>
                        <div class="progress" style="height: 1.25rem;" role="progressbar"
                             aria-valuenow="@((int)(job.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(JobDisplay.IsRunning(job.State) ? "progress-bar-striped progress-bar-animated" : "")"
                                 style="width: @((int)(job.Progress * 100))%;">
                                @((int)(job.Progress * 100))%
                            </div>
                        </div>
                        @if (job.TotalChunks > 0)
                        {
                            <div class="small text-muted">@ChunkLabel(job)</div>
                        }
                    </td>
                    <td class="text-end font-monospace">@JobDisplay.Elapsed(job)</td>
                    <td class="text-end font-monospace">@JobDisplay.RealtimeFactor(job)</td>
                    <td class="text-end text-nowrap">
                        @if (JobDisplay.IsActive(job.State))
                        {
                            <AuthorizeView Policy="@Roles.MemberPolicy">
                                <form method="post" action="/jobs/@job.Id/cancel" class="d-inline">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button>
                                </form>
                            </AuthorizeView>
                        }
                        else
                        {
                            @if (job.State is JobState.Failed or JobState.Cancelled)
                            {
                                <AuthorizeView Policy="@Roles.MemberPolicy">
                                    <form method="post" action="/jobs/@job.Id/retry" class="d-inline me-1">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Retry</button>
                                    </form>
                                </AuthorizeView>
                            }
                            @* Only the job history goes; the transcript it produced is untouched. *@
                            <AuthorizeView Policy="@Roles.AdminPolicy">
                                <a class="btn btn-sm" href="/delete/job/@job.Id"
                                   title="Remove this job from the history">Delete</a>
                            </AuthorizeView>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="pwa-job-list">
        @foreach (var job in _jobs)
        {
            <article class="pwa-job-card">
                <a class="pwa-job-title" href="/episodes/@job.EpisodeId">
                    @(job.Episode?.Title ?? $"Episode {job.EpisodeId}")
                </a>
                <div class="pwa-job-show">@(job.Episode?.Show ?? "No show")</div>

                <div class="pwa-job-state">
                    <span class="badge @JobDisplay.BadgeClass(job.State)">@job.State</span>
                    <span>@((int)(job.Progress * 100))%</span>
                </div>

                <div class="progress pwa-job-progress" role="progressbar"
                     aria-label="@job.State progress"
                     aria-valuenow="@((int)(job.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(JobDisplay.IsRunning(job.State) ? "progress-bar-striped progress-bar-animated" : "")"
                         style="width: @((int)(job.Progress * 100))%;"></div>
                </div>

                @if (job.TotalChunks > 0)
                {
                    <div class="pwa-job-chunks">@ChunkLabel(job)</div>
                }

                <div class="pwa-job-meta">
                    <span>queued by @(job.QueuedBy ?? "system")</span>
                    <span>attempt @Math.Max(job.Attempts, 1)</span>
                </div>
                <div class="pwa-job-meta">
                    <span>@JobDisplay.Elapsed(job) elapsed</span>
                    <span>@JobDisplay.RealtimeFactor(job) realtime</span>
                </div>

                @if (job.LastError is { } error)
                {
                    <details class="pwa-job-error">
                        <summary>Show error details</summary>
                        <div>@error</div>
                    </details>
                }
                @if (job.NextAttemptAt is { } next && job.State == JobState.Queued)
                {
                    <div class="pwa-job-retry-time">
                        retrying at @next.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                    </div>
                }

                <div class="pwa-job-footer">
                    <div class="pwa-job-actions">
                        <a class="btn btn-sm" href="/episodes/@job.EpisodeId">Open episode</a>
                        @if (JobDisplay.IsActive(job.State))
                        {
                            <AuthorizeView Policy="@Roles.MemberPolicy">
                                <form method="post" action="/jobs/@job.Id/cancel">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn-sm">Cancel</button>
                                </form>
                            </AuthorizeView>
                        }
                        else
                        {
                            @if (job.State is JobState.Failed or JobState.Cancelled)
                            {
                                <AuthorizeView Policy="@Roles.MemberPolicy">
                                    <form method="post" action="/jobs/@job.Id/retry">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-sm">Retry</button>
                                    </form>
                                </AuthorizeView>
                            }
                            <AuthorizeView Policy="@Roles.AdminPolicy">
                                <a class="btn btn-sm" href="/delete/job/@job.Id"
                                   title="Remove this job from the history">Delete</a>
                            </AuthorizeView>
                        }
                    </div>
                    <time datetime="@job.CreatedAt.ToString("O")">
                        @job.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </time>
                </div>
            </article>
        }
    </div>
}

@code {
    private static readonly (string Value, string Label)[] StateFilters =
    [
        ("all", "All jobs"),
        ("active", "Active"),
        ("failed", "Failed"),
        ("completed", "Completed"),
        ("cancelled", "Cancelled")
    ];

    private List<Job>? _jobs;

    private static string ChunkLabel(Job job) =>
        job.Kind == JobKind.Summarization
            ? $"pass {job.CompletedChunks} of {job.TotalChunks}"
            : $"chunk {job.CompletedChunks} of {job.TotalChunks}";

    [SupplyParameterFromQuery(Name = "error")] private string? DeleteError { get; set; }
    [SupplyParameterFromQuery(Name = "state")] private string? State { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] private string? Sort { get; set; }
    private string _stateFilter = "all";
    private string _sort = "newest";
    private Timer? _ticker;

    protected override void OnInitialized()
    {
        Notifier.JobChanged += OnJobChanged;

        // The worker pushes state changes, but elapsed time and the realtime factor keep moving
        // between them, so the running rows need a clock of their own.
        _ticker = new Timer(_ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnParametersSetAsync()
    {
        _stateFilter = StateFilters.Any(filter => filter.Value == State) ? State! : "all";
        _sort = Sort == "oldest" ? "oldest" : "newest";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Jobs.Include(j => j.Episode).AsQueryable();

        query = _stateFilter switch
        {
            "active" => query.Where(j =>
                j.State == JobState.Queued ||
                j.State == JobState.Downloading ||
                j.State == JobState.Preparing ||
                j.State == JobState.Transcribing ||
                j.State == JobState.Summarizing),
            "failed" => query.Where(j => j.State == JobState.Failed),
            "completed" => query.Where(j => j.State == JobState.Completed),
            "cancelled" => query.Where(j => j.State == JobState.Cancelled),
            _ => query
        };

        var activeFirst = query.OrderByDescending(j =>
            j.State == JobState.Queued ||
            j.State == JobState.Downloading ||
            j.State == JobState.Preparing ||
            j.State == JobState.Transcribing ||
            j.State == JobState.Summarizing);

        _jobs = await (_sort == "oldest"
                ? activeFirst.ThenBy(j => j.CreatedAt)
                : activeFirst.ThenByDescending(j => j.CreatedAt))
            .Take(100)
            .ToListAsync();
    }

    private void OnJobChanged(int jobId) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });


    public void Dispose()
    {
        Notifier.JobChanged -= OnJobChanged;
        _ticker?.Dispose();
    }
}
