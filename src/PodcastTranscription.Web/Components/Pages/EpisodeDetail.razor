@page "/episodes/{EpisodeId:int}"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Components.Shared
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Summarization
@using PodcastTranscription.Web.Services.Security
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject JobQueue Queue
@inject JobNotifier Notifier
@inject DeletionService Deletion
@inject WhisperClient Whisper
@inject SummaryService Summaries
@inject SummaryRunner Runner
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.WebUtilities
@inject IJSRuntime JS

<PageTitle>@(_episode?.Title ?? "Episode")</PageTitle>

@if (_episode is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="episode-heading d-flex justify-content-between align-items-start mb-3">
        <div class="episode-identity">
            @if (_editingMetadata)
            {
                <form method="post" action="/episodes/@EpisodeId/metadata" class="episode-metadata-form">
                    <AntiforgeryToken />
                    <div>
                        <label class="form-label" for="episode-title">Title</label>
                        <input id="episode-title" name="title" class="form-control"
                               value="@_episode.Title" required />
                    </div>
                    <div>
                        <label class="form-label" for="episode-show">
                            Show <span class="text-muted">(optional)</span>
                        </label>
                        <input id="episode-show" name="show" class="form-control" value="@_episode.Show" />
                    </div>
                    <div class="episode-metadata-actions">
                        <button type="submit" class="btn btn-primary btn-sm">Save details</button>
                        <a class="btn btn-sm" href="/episodes/@EpisodeId">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <div class="episode-title-row">
                    <h1 class="h3 mb-1">@_episode.Title</h1>
                    <AuthorizeView Policy="@Roles.MemberPolicy">
                        <a class="btn btn-sm episode-edit-button"
                           href="/episodes/@EpisodeId?metadata=edit">Edit details</a>
                    </AuthorizeView>
                </div>
                <div class="text-muted small">
                    @(_episode.Show ?? "No show")
                    · @TimeFormat.Duration(_episode.DurationSec)
                    · added @_episode.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            }
        </div>
        <div class="text-end">
            @if (_activeJob is null)
            {
                <AuthorizeView Policy="@Roles.AdminPolicy">
                    <div class="episode-delete-header d-flex justify-content-end align-items-center gap-2 mb-2">
                        <a class="btn btn-sm" href="/delete/episode/@EpisodeId"
                           title="Delete this episode, its transcripts and its audio">Delete episode</a>
                    </div>
                </AuthorizeView>
                <AuthorizeView Policy="@Roles.MemberPolicy">
                <form method="post" action="/episodes/@EpisodeId/transcribe" class="input-group">
                    <AntiforgeryToken />
                    @* Recorded against the transcript, so the back catalogue can be reprocessed
                       on a better model and the results compared. *@
                    <input name="model" class="form-control form-control-sm" style="max-width: 14rem;"
                           placeholder="@Whisper.Model" aria-label="Model" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        @(_transcripts.Count == 0 ? "Transcribe" : "Re-transcribe")
                    </button>
                </form>
                </AuthorizeView>
            }
            else
            {
                <AuthorizeView Policy="@Roles.MemberPolicy">
                    <form method="post" action="/episodes/@EpisodeId/jobs/@_activeJob.Id/cancel">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary">Cancel</button>
                    </form>
                </AuthorizeView>
            }
        </div>
    </div>

    @if (_hasAudio)
    {
        <div class="episode-player mb-3">
            <audio id="episode-audio" controls preload="metadata" src="/media/episodes/@EpisodeId/audio"></audio>
        </div>
    }

    @if (_activeJob is { } job)
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>
                        <span class="badge @JobDisplay.BadgeClass(job.State)">@job.State</span>
                        @if (job.TotalChunks > 0)
                        {
                            <span class="ms-2 text-muted small">chunk @job.CompletedChunks of @job.TotalChunks</span>
                        }
                    </span>
                    <span class="text-muted small font-monospace">
                        @JobDisplay.Elapsed(job) elapsed · @JobDisplay.RealtimeFactor(job) realtime
                    </span>
                </div>
                <div class="progress" style="height: 1.25rem;" role="progressbar"
                     aria-valuenow="@((int)(job.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(JobDisplay.IsRunning(job.State) ? "progress-bar-striped progress-bar-animated" : "")"
                         style="width: @((int)(job.Progress * 100))%;">
                        @((int)(job.Progress * 100))%
                    </div>
                </div>
                @if (job.State == JobState.Transcribing)
                {
                    <div class="small text-muted mt-2">
                        Segments appear as each chunk lands — no need to wait for the whole episode.
                    </div>
                }
            </div>
        </div>
    }

    @if (Notice is { } notice)
    {
        <div class="alert alert-success py-2">@notice</div>
    }

    @if (PageError is { } pageError)
    {
        <div class="alert alert-warning py-2">@pageError</div>
    }

    @if (_lastFailure is { } failure)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center">
            <span class="job-error" title="@failure.LastError"><strong>@failure.State.</strong> @failure.LastError</span>
            <AuthorizeView Policy="@Roles.MemberPolicy">
                <form method="post" action="/episodes/@EpisodeId/jobs/@failure.Id/retry">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Retry</button>
                </form>
            </AuthorizeView>
        </div>
    }

    @if (_transcripts.Count == 0)
    {
        <p class="text-muted">No transcript yet.</p>
    }
    else
    {
        @if (_transcripts.Count > 1)
        {
            <ul class="nav nav-pills mb-3">
                @foreach (var t in _transcripts)
                {
                    <li class="nav-item">
                        @* A link rather than a click handler: picking a run is navigation, and
                           navigation works without a circuit. *@
                        <a class="nav-link @(t.Id == Selected?.Id ? "active" : "")"
                           href="/episodes/@EpisodeId?transcript=@t.Id">
                            @t.Model
                            <span class="small opacity-75">@t.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        </a>
                    </li>
                }
            </ul>
        }

        @if (Selected is { } selected)
        {
            <div class="reader-tools d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="text-muted small">
                    @selected.Segments.Count segments
                    · model @selected.Model
                    · language @(selected.Language ?? "unknown")
                    @if (selected.RealtimeFactor is { } factor)
                    {
                        <span> · @factor.ToString("N1")× realtime</span>
                    }
                    @if (!selected.IsComplete)
                    {
                        <span class="badge bg-info text-dark ms-2">partial</span>
                    }
                </div>

                <div class="reader-actions">
                    <div class="reader-action-row">
                        <span class="reader-action-label">Display</span>
                        <div class="reader-action-controls">
                            @* The toggles that used to sit here — Edit text, Compare runs, Word timings,
                               Low confidence — were @onchange handlers, so they needed a live Blazor
                               circuit and did nothing at all without one: they ticked and the page never
                               changed. Word timings and confidence shading cost nothing to render, so
                               they are simply always on now, and correcting a line is a link. *@
                            <AuthorizeView Policy="@Roles.MemberPolicy">
                                @if (_editing)
                                {
                                    <a class="btn btn-sm" href="@ViewLink(selected.Id)">Done correcting</a>
                                }
                                else
                                {
                                    <a class="btn btn-sm" href="@ViewLink(selected.Id, edit: true)"
                                       title="Turn each line into a text box so you can correct what whisper misheard">
                                        Correct text
                                    </a>
                                }
                            </AuthorizeView>

                            @* Shading every uncertain word is a lot of colour to look at all the time, so
                               it stays opt-in — as a link rather than the checkbox it used to be. *@
                            <a class="btn btn-sm" href="@ViewLink(selected.Id, shade: !_shading)"
                               title="Shade the words whisper was least sure of, amber through red">
                                @(_shading ? "Hide shading" : "Low confidence")
                            </a>
                        </div>
                    </div>

                    <AuthorizeView Policy="@Roles.AdminPolicy">
                        <div class="reader-action-row">
                            <span class="reader-action-label">Delete</span>
                            <div class="reader-action-controls">
                                <a class="btn btn-sm metro-only-action" href="/delete/episode/@EpisodeId"
                                   title="Delete this episode, its transcripts and its audio">Episode</a>
                                <a class="btn btn-sm" href="/delete/transcript/@selected.Id?episodeId=@EpisodeId"
                                   title="Delete this transcript, keeping the episode and its audio">Transcript</a>
                            </div>
                        </div>
                    </AuthorizeView>

                    @* Plain links rather than a dropdown: a dropdown needs Bootstrap's JavaScript,
                       which this app does not load, so the button did nothing at all. *@
                    <div class="reader-action-row">
                        <span class="reader-action-label">Export</span>
                        <span class="reader-action-controls export-links small">
                            @foreach (var (format, label, extension) in ExportFormats)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/episodes/@EpisodeId/transcripts/@selected.Id/export/@format"
                                   title="@label">@extension</a>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="text-muted small mb-2 toolbar-hint">
                Each word highlights as the audio plays, and clicking one jumps the player there.
                <strong>Low confidence</strong> shades the words whisper was least sure of, amber
                through red — the quickest way to find a mangled name. <strong>Correct text</strong>
                turns every line into a box you can fix, and search picks the correction up.
            </div>

            <nav class="reader-pivot" aria-label="Episode reader">
                <a href="@($"/episodes/{EpisodeId}{ReaderQuery}#summary-card")">summary</a>
                <a href="@($"/episodes/{EpisodeId}{ReaderQuery}#transcript-body")">transcript</a>
            </nav>

            <SummaryCard Summary="selected.Summary"
                         EpisodeId="EpisodeId"
                         TranscriptId="selected.Id"
                         Run="SummaryRun"
                         Enabled="Summaries.Enabled"
                         ModelName="@Summaries.Model" />

            @if (selected.QualityWarning is { } warning)
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center">
                    <span><strong>Possible transcription fault.</strong> @warning</span>
                    <AuthorizeView Policy="@Roles.MemberPolicy">
                        <form method="post" action="/episodes/@EpisodeId/transcribe">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-dark">Re-transcribe</button>
                        </form>
                    </AuthorizeView>
                </div>
            }

            @if (selected.Segments.All(s => string.IsNullOrEmpty(s.WordsJson)))
            {
                <div class="alert alert-secondary py-2 small">
                    This transcript has no word timings — it was produced with
                    <code>Transcription:WordTimestamps</code> off. Re-transcribe to get them.
                </div>
            }

            @if (_comparing && CompareAgainst is { } other)
            {
                <div class="row g-3 compare">
                    <div class="col-6">
                        <div class="small text-muted mb-1">
                            <strong>@selected.Model</strong>
                            · @selected.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                        </div>
                        <TranscriptView Segments="selected.Segments" Follow="true" />
                    </div>
                    <div class="col-6">
                        <div class="small text-muted mb-1">
                            <strong>@other.Model</strong>
                            · @other.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                        </div>
                        @* Only the left column drives the player; two would fight over it. *@
                        <TranscriptView Segments="other.Segments" Follow="false" />
                    </div>
                </div>
            }
            else
            {
                @* Words and shading are always rendered now: they cost one span per word and
                   they were the whole point of keeping word timings. *@
                <TranscriptView Segments="selected.Segments"
                                ShowWords="true"
                                ShadeConfidence="_shading"
                                Follow="true"
                                Editable="_editing"
                                EpisodeId="EpisodeId" />
            }
        }
    }
}

@code {
    [Parameter] public int EpisodeId { get; set; }

    private static readonly (string Format, string Label, string Extension)[] ExportFormats =
    [
        ("srt", "SubRip subtitles — for video editors and players", "SRT"),
        ("vtt", "WebVTT subtitles — for the web", "VTT"),
        ("txt", "Plain text, no timestamps", "TXT"),
        ("json", "JSON with word timings and per-word confidence", "JSON"),
        ("md", "Markdown with a timestamp on every line", "MD")
    ];

    private Episode? _episode;
    private List<Transcript> _transcripts = [];
    private Job? _activeJob;
    private Job? _lastFailure;
    private Timer? _ticker;
    private bool _hasAudio;
    private bool _playerReady;

    // A ?t=ms deep link from search: seek there once the player is on the page.
    private int? _pendingSeekMs;

    /// <summary>
    /// Which run is shown, whether lines are editable and whether two runs sit side by side all
    /// come from the URL rather than from component state. They used to be click handlers, which
    /// need a live Blazor circuit — and where the circuit does not connect those controls did
    /// nothing whatsoever. A link changes the URL, and links work everywhere.
    /// </summary>
    private int? SelectedId => int.TryParse(Query("transcript"), out var id) ? id : null;

    private bool _editing => Query("edit") == "1";

    private bool _editingMetadata => Query("metadata") == "edit";

    private bool _comparing => Query("compare") == "1" && _transcripts.Count > 1;

    private bool _shading => Query("shade") == "1";

    private string ReaderQuery => Selected is { } selected
        ? $"?transcript={selected.Id}{(_editing ? "&edit=1" : "")}{(_shading ? "&shade=1" : "")}"
        : string.Empty;

    /// <summary>
    /// Builds a link to this page with the view options it should carry. Everything the toolbar
    /// used to toggle over the circuit is a URL now, so each of these is shareable and each of
    /// them survives a reload.
    /// </summary>
    private string ViewLink(int transcriptId, bool? edit = null, bool? shade = null)
    {
        var parts = new List<string> { $"transcript={transcriptId}" };

        if (edit ?? _editing)
        {
            parts.Add("edit=1");
        }

        if (shade ?? _shading)
        {
            parts.Add("shade=1");
        }

        return $"/episodes/{EpisodeId}?" + string.Join("&", parts);
    }

    private string? Notice => Query("notice");

    private string? PageError => Query("error");

    private string? Query(string key) =>
        QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue(key, out var value)
            ? value.ToString()
            : null;

    private Transcript? Selected =>
        _transcripts.FirstOrDefault(t => t.Id == SelectedId) ?? _transcripts.FirstOrDefault();

    /// <summary>The next most recent transcript, which is what a comparison is against.</summary>
    private Transcript? CompareAgainst => _transcripts.FirstOrDefault(t => t.Id != Selected?.Id);

    /// <summary>
    /// The in-flight summarisation for the shown transcript, if any. Read straight from the
    /// singleton so the progress bar renders correctly on a plain page load — the polling script
    /// keeps it moving after that, again without needing a circuit.
    /// </summary>
    private SummaryRun? SummaryRun => Selected is { } t ? Runner.For(t.Id) : null;

    protected override void OnInitialized()
    {
        Notifier.JobChanged += OnJobChanged;
        _ticker = new Timer(_ => { if (_activeJob is not null) InvokeAsync(StateHasChanged); }, null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnParametersSetAsync()
    {
        ReadSeekFromQuery();
        await LoadAsync();
    }

    private void ReadSeekFromQuery()
    {
        if (int.TryParse(Query("t"), out var ms))
        {
            _pendingSeekMs = ms;
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _episode = await db.Episodes.FirstOrDefaultAsync(e => e.Id == EpisodeId);
        if (_episode is null)
        {
            return;
        }

        _hasAudio = !string.IsNullOrWhiteSpace(_episode.AudioPath) || !string.IsNullOrWhiteSpace(_episode.PreparedAudioPath);

        _transcripts = await db.Transcripts
            .Where(t => t.EpisodeId == EpisodeId)
            .Include(t => t.Segments.OrderBy(s => s.Ordinal))
            .Include(t => t.Summary)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();

        var jobs = await db.Jobs
            .Where(j => j.EpisodeId == EpisodeId)
            .OrderByDescending(j => j.CreatedAt)
            .Take(10)
            .ToListAsync();

        _activeJob = jobs.FirstOrDefault(j => JobDisplay.IsActive(j.State));
        _lastFailure = _activeJob is null
            ? jobs.FirstOrDefault(j => j.State is JobState.Failed or JobState.Cancelled)
            : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasAudio || Selected is null)
        {
            return;
        }

        // Re-bind after every render: the transcript elements the player tracks are replaced
        // whenever the page re-renders.
        await JS.InvokeVoidAsync("podcastPlayer.init", "episode-audio", "transcript-body", "summary-body");
        _playerReady = true;

        if (_pendingSeekMs is { } ms)
        {
            _pendingSeekMs = null;
            await JS.InvokeVoidAsync("podcastPlayer.seek", ms);
        }
    }

    private void OnJobChanged(int jobId) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Notifier.JobChanged -= OnJobChanged;
        _ticker?.Dispose();

        if (_playerReady)
        {
            try
            {
                await JS.InvokeVoidAsync("podcastPlayer.dispose");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to clean up on the client.
            }
        }
    }
}
