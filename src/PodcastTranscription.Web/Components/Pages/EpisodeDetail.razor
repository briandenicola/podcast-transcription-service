@page "/episodes/{EpisodeId:int}"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using PodcastTranscription.Web.Components.Shared
@using PodcastTranscription.Web.Data
@using PodcastTranscription.Web.Domain
@using PodcastTranscription.Web.Services
@using PodcastTranscription.Web.Services.Summarization
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject JobQueue Queue
@inject JobNotifier Notifier
@inject DeletionService Deletion
@inject WhisperClient Whisper
@inject SummaryService Summaries
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_episode?.Title ?? "Episode")</PageTitle>

@if (_episode is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1">@_episode.Title</h1>
            <div class="text-muted small">
                @(_episode.Show ?? "No show")
                · @TimeFormat.Duration(_episode.DurationSec)
                · added @_episode.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            </div>
        </div>
        <div class="text-end">
            @if (_activeJob is null)
            {
                <div class="d-flex justify-content-end align-items-center gap-2 mb-2">
                    <a class="btn btn-sm" href="/delete/episode/@EpisodeId"
                       title="Delete this episode, its transcripts and its audio">Delete episode</a>
                </div>
                <div class="input-group">
                    @* Recorded against the transcript, so the back catalogue can be reprocessed
                       on a better model and the results compared. *@
                    <input class="form-control form-control-sm" style="max-width: 14rem;"
                           @bind="_modelOverride" placeholder="@Whisper.Model" aria-label="Model" />
                    <button class="btn btn-primary btn-sm" @onclick="Enqueue">
                        @(_transcripts.Count == 0 ? "Transcribe" : "Re-transcribe")
                    </button>
                </div>
            }
            else
            {
                <button class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
            }
        </div>
    </div>

    @if (_hasAudio)
    {
        <div class="episode-player mb-3">
            <audio id="episode-audio" controls preload="metadata" src="/media/episodes/@EpisodeId/audio"></audio>
        </div>
    }

    @if (_activeJob is { } job)
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>
                        <span class="badge @JobDisplay.BadgeClass(job.State)">@job.State</span>
                        @if (job.TotalChunks > 0)
                        {
                            <span class="ms-2 text-muted small">chunk @job.CompletedChunks of @job.TotalChunks</span>
                        }
                    </span>
                    <span class="text-muted small font-monospace">
                        @JobDisplay.Elapsed(job) elapsed · @JobDisplay.RealtimeFactor(job) realtime
                    </span>
                </div>
                <div class="progress" style="height: 1.25rem;" role="progressbar"
                     aria-valuenow="@((int)(job.Progress * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(JobDisplay.IsRunning(job.State) ? "progress-bar-striped progress-bar-animated" : "")"
                         style="width: @((int)(job.Progress * 100))%;">
                        @((int)(job.Progress * 100))%
                    </div>
                </div>
                @if (job.State == JobState.Transcribing)
                {
                    <div class="small text-muted mt-2">
                        Segments appear as each chunk lands — no need to wait for the whole episode.
                    </div>
                }
            </div>
        </div>
    }

    @if (_deletionMessage is not null)
    {
        <div class="alert alert-warning py-2">@_deletionMessage</div>
    }

    @if (_lastFailure is { } failure)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center">
            <span class="job-error" title="@failure.LastError"><strong>@failure.State.</strong> @failure.LastError</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => Retry(failure.Id)">Retry</button>
        </div>
    }

    @if (_transcripts.Count == 0)
    {
        <p class="text-muted">No transcript yet.</p>
    }
    else
    {
        @if (_transcripts.Count > 1)
        {
            <ul class="nav nav-pills mb-3">
                @foreach (var t in _transcripts)
                {
                    <li class="nav-item">
                        <button class="nav-link @(t.Id == _selectedId ? "active" : "")" @onclick="() => Select(t.Id)">
                            @t.Model
                            <span class="small opacity-75">@t.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        </button>
                    </li>
                }
            </ul>
        }

        @if (Selected is { } selected)
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="text-muted small">
                    @selected.Segments.Count segments
                    · model @selected.Model
                    · language @(selected.Language ?? "unknown")
                    @if (selected.RealtimeFactor is { } factor)
                    {
                        <span> · @factor.ToString("N1")× realtime</span>
                    }
                    @if (!selected.IsComplete)
                    {
                        <span class="badge bg-info text-dark ms-2">partial</span>
                    }
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="form-check form-switch mb-0"
                         title="Turn each line into a text box so you can correct what whisper misheard. Changes save as you leave a line, and search picks them up.">
                        <input class="form-check-input" type="checkbox" id="edit-mode"
                               checked="@_editing" @onchange="ToggleEditing" />
                        <label class="form-check-label small" for="edit-mode">Edit text</label>
                    </div>
                    @if (_transcripts.Count > 1)
                    {
                        <div class="form-check form-switch mb-0"
                             title="Show this transcript beside the previous run, so two models can be compared line by line.">
                            <input class="form-check-input" type="checkbox" id="compare-mode"
                                   checked="@_comparing" @onchange="ToggleCompare" />
                            <label class="form-check-label small" for="compare-mode">Compare runs</label>
                        </div>
                    }
                    <div class="form-check form-switch mb-0"
                         title="Show every word separately: the word being spoken highlights as the audio plays, and clicking any word jumps the player to it.">
                        <input class="form-check-input" type="checkbox" id="show-words"
                               checked="@_showWords" @onchange="ToggleWords" />
                        <label class="form-check-label small" for="show-words">Word timings</label>
                    </div>
                    <div class="form-check form-switch mb-0"
                         title="Shade the words whisper was least sure of, amber through red. The quickest way to find mangled names.">
                        <input class="form-check-input" type="checkbox" id="shade-confidence"
                               checked="@_shadeConfidence" @onchange="ToggleShading" />
                        <label class="form-check-label small" for="shade-confidence">Low confidence</label>
                    </div>

                    @* Throws away one run without touching the audio, so it can be transcribed again. *@
                    <a class="btn btn-sm" href="/delete/transcript/@selected.Id?episodeId=@EpisodeId"
                       title="Delete this transcript, keeping the episode and its audio">Delete transcript</a>

                    @* Plain links rather than a dropdown: a dropdown needs Bootstrap's JavaScript,
                       which this app does not load, so the button did nothing at all. *@
                    <span class="export-links small">
                        <span class="text-muted me-1">Export</span>
                        @foreach (var (format, label, extension) in ExportFormats)
                        {
                            <a class="btn btn-sm btn-outline-secondary"
                               href="/episodes/@EpisodeId/transcripts/@selected.Id/export/@format"
                               title="@label">@extension</a>
                        }
                    </span>
                </div>
            </div>

            <div class="text-muted small mb-2 toolbar-hint">
                <strong>Edit text</strong> corrects what whisper misheard ·
                <strong>Word timings</strong> highlights each word as it plays and lets you click one to jump there ·
                <strong>Low confidence</strong> shades the words it was unsure of
            </div>

            <SummaryCard Summary="selected.Summary"
                         Enabled="Summaries.Enabled"
                         Busy="_summarizing"
                         Error="@_summaryError"
                         ModelName="@Summaries.Model"
                         OnSummarize="() => Summarize(selected.Id)" />

            @if (selected.QualityWarning is { } warning)
            {
                <div class="alert alert-warning d-flex justify-content-between align-items-center">
                    <span><strong>Possible transcription fault.</strong> @warning</span>
                    <button class="btn btn-sm btn-outline-dark" @onclick="Enqueue">Re-transcribe</button>
                </div>
            }

            @if (_showWords && selected.Segments.All(s => string.IsNullOrEmpty(s.WordsJson)))
            {
                <div class="alert alert-secondary py-2 small">
                    This transcript has no word timings — it was produced with
                    <code>Transcription:WordTimestamps</code> off. Re-transcribe to get them.
                </div>
            }

            @if (_comparing && CompareAgainst is { } other)
            {
                <div class="row g-3 compare">
                    <div class="col-6">
                        <div class="small text-muted mb-1">
                            <strong>@selected.Model</strong>
                            · @selected.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                        </div>
                        <TranscriptView Segments="selected.Segments" Follow="_follow" />
                    </div>
                    <div class="col-6">
                        <div class="small text-muted mb-1">
                            <strong>@other.Model</strong>
                            · @other.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                        </div>
                        @* Only the left column drives the player; two would fight over it. *@
                        <TranscriptView Segments="other.Segments" Follow="false" />
                    </div>
                </div>
            }
            else
            {
                <TranscriptView Segments="selected.Segments"
                                ShowWords="_showWords"
                                ShadeConfidence="_shadeConfidence"
                                Follow="_follow"
                                Editable="_editing"
                                SegmentEdited="SaveSegment" />
            }
        }
    }
}

@code {
    [Parameter] public int EpisodeId { get; set; }

    private static readonly (string Format, string Label, string Extension)[] ExportFormats =
    [
        ("srt", "SubRip subtitles — for video editors and players", "SRT"),
        ("vtt", "WebVTT subtitles — for the web", "VTT"),
        ("txt", "Plain text, no timestamps", "TXT"),
        ("json", "JSON with word timings and per-word confidence", "JSON"),
        ("md", "Markdown with a timestamp on every line", "MD")
    ];

    private Episode? _episode;
    private List<Transcript> _transcripts = [];
    private int? _selectedId;
    private Job? _activeJob;
    private Job? _lastFailure;
    private Timer? _ticker;
    private string? _deletionMessage;
    private bool _hasAudio;
    private bool _showWords;
    private bool _shadeConfidence;
    private bool _editing;
    private bool _comparing;
    private bool _summarizing;
    private string? _summaryError;
    private string? _modelOverride;
    private readonly bool _follow = true;

    /// <summary>The next most recent transcript, which is what a comparison is against.</summary>
    private Transcript? CompareAgainst =>
        _transcripts.FirstOrDefault(t => t.Id != Selected?.Id);

    // A ?t=ms deep link from search: seek there once the player is on the page.
    private int? _pendingSeekMs;
    private bool _playerReady;

    private Transcript? Selected => _transcripts.FirstOrDefault(t => t.Id == _selectedId) ?? _transcripts.FirstOrDefault();

    protected override void OnInitialized()
    {
        Notifier.JobChanged += OnJobChanged;
        _ticker = new Timer(_ => { if (_activeJob is not null) InvokeAsync(StateHasChanged); }, null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnParametersSetAsync()
    {
        ReadSeekFromQuery();
        await LoadAsync();
    }

    private void ReadSeekFromQuery()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("t", out var value) && int.TryParse(value, out var ms))
        {
            _pendingSeekMs = ms;
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _episode = await db.Episodes.FirstOrDefaultAsync(e => e.Id == EpisodeId);
        if (_episode is null)
        {
            return;
        }

        _hasAudio = !string.IsNullOrWhiteSpace(_episode.AudioPath) || !string.IsNullOrWhiteSpace(_episode.PreparedAudioPath);

        _transcripts = await db.Transcripts
            .Where(t => t.EpisodeId == EpisodeId)
            .Include(t => t.Segments.OrderBy(s => s.Ordinal))
            .Include(t => t.Summary)
            .OrderByDescending(t => t.CreatedAt)
            .ToListAsync();

        _selectedId ??= _transcripts.FirstOrDefault()?.Id;

        var jobs = await db.Jobs
            .Where(j => j.EpisodeId == EpisodeId)
            .OrderByDescending(j => j.CreatedAt)
            .Take(10)
            .ToListAsync();

        _activeJob = jobs.FirstOrDefault(j => JobDisplay.IsActive(j.State));
        _lastFailure = _activeJob is null
            ? jobs.FirstOrDefault(j => j.State is JobState.Failed or JobState.Cancelled)
            : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasAudio || Selected is null)
        {
            return;
        }

        // Re-bind after every render: toggling words replaces the elements the player tracks.
        // The third container is the summary card, whose [hh:mm:ss] cues seek the same player.
        // Absent until a summary exists, which the player treats as optional.
        await JS.InvokeVoidAsync("podcastPlayer.init", "episode-audio", "transcript-body", "summary-body");
        _playerReady = true;

        if (_pendingSeekMs is { } ms)
        {
            _pendingSeekMs = null;
            await JS.InvokeVoidAsync("podcastPlayer.seek", ms);
        }
    }

    private void Select(int transcriptId) => _selectedId = transcriptId;

    private void ToggleWords(ChangeEventArgs e) => _showWords = e.Value is true;

    private void ToggleEditing(ChangeEventArgs e)
    {
        _editing = e.Value is true;

        // Editing replaces the lines with inputs, so word rendering and comparison get in the way.
        if (_editing)
        {
            _showWords = false;
            _shadeConfidence = false;
            _comparing = false;
        }
    }

    private void ToggleCompare(ChangeEventArgs e)
    {
        _comparing = e.Value is true;

        if (_comparing)
        {
            _editing = false;
        }
    }

    private async Task SaveSegment(Segment segment)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var stored = await db.Segments.FirstOrDefaultAsync(s => s.Id == segment.Id);
        if (stored is null)
        {
            return;
        }

        stored.Text = segment.Text;
        stored.IsEdited = true;
        stored.WordsJson = segment.WordsJson;

        // The FTS triggers pick this up inside SQLite, so search reflects the correction with
        // nothing extra to remember here.
        await db.SaveChangesAsync();
    }

    private void ToggleShading(ChangeEventArgs e)
    {
        _shadeConfidence = e.Value is true;

        // Shading is per word, so it needs the word spans rendered.
        if (_shadeConfidence)
        {
            _showWords = true;
        }
    }

    private void OnJobChanged(int jobId) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Runs the summary on demand. Long enough to need the busy state — several minutes on a
    /// three-hour episode — but it is a foreground action someone asked for, so it is awaited
    /// here rather than pushed through the job queue.
    /// </summary>
    private async Task Summarize(int transcriptId)
    {
        _summarizing = true;
        _summaryError = null;

        try
        {
            var result = await Summaries.SummarizeAsync(transcriptId);
            _summaryError = result.Error;

            await LoadAsync();
        }
        finally
        {
            _summarizing = false;
        }
    }

    private async Task Enqueue()
    {
        await Queue.EnqueueAsync(EpisodeId, model: string.IsNullOrWhiteSpace(_modelOverride) ? null : _modelOverride.Trim());
        await LoadAsync();
    }

    private async Task Cancel()
    {
        if (_activeJob is { } job)
        {
            await Queue.CancelAsync(job.Id);
            await LoadAsync();
        }
    }

    private async Task Retry(int jobId)
    {
        await Queue.RetryAsync(jobId);
        await LoadAsync();
    }

    private async Task DeleteTranscript(int transcriptId)
    {
        var result = await Deletion.DeleteTranscriptAsync(transcriptId);
        _deletionMessage = result.Refusal;

        if (result.Deleted)
        {
            _selectedId = null;
        }

        await LoadAsync();
    }

    private async Task DeleteEpisode()
    {
        var result = await Deletion.DeleteEpisodeAsync(EpisodeId);

        if (result.Deleted)
        {
            Navigation.NavigateTo("/");
            return;
        }

        _deletionMessage = result.Refusal;
    }

    public async ValueTask DisposeAsync()
    {
        Notifier.JobChanged -= OnJobChanged;
        _ticker?.Dispose();

        if (_playerReady)
        {
            try
            {
                await JS.InvokeVoidAsync("podcastPlayer.dispose");
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to clean up on the client.
            }
        }
    }
}
