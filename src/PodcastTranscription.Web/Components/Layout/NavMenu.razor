@using Microsoft.AspNetCore.Components.Authorization
@using PodcastTranscription.Web.Services.Security

<div class="nav-header">Podcast Transcription</div>

<nav class="nav">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon" aria-hidden="true">📚</span> Library
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="search">
            <span class="nav-icon" aria-hidden="true">🔍</span> Search
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="jobs">
            <span class="nav-icon" aria-hidden="true">⏳</span> Jobs
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="feeds">
            <span class="nav-icon" aria-hidden="true">📡</span> Feeds
        </NavLink>
    </div>

    @* Adding an episode is members and up; the endpoint refuses viewers either way, so this
       only saves them a button that would fail. *@
    <AuthorizeView Policy="@Roles.MemberPolicy">
        <div class="nav-item">
            <NavLink class="nav-link" href="upload">
                <span class="nav-icon" aria-hidden="true">➕</span> Add episode
            </NavLink>
        </div>
    </AuthorizeView>

    <AuthorizeView Policy="@Roles.AdminPolicy">
        <div class="nav-item">
            <NavLink class="nav-link" href="users">
                <span class="nav-icon" aria-hidden="true">👥</span> Users
            </NavLink>
        </div>
    </AuthorizeView>
</nav>
