@using Microsoft.AspNetCore.Components.Authorization
@using PodcastTranscription.Web.Services.Security

<div class="nav-header">Podcast Transcription</div>

<nav class="nav desktop-nav">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon" aria-hidden="true">📚</span>
            <span class="metro-icon" aria-hidden="true">▦</span>
            <span class="nav-label">Library</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="search">
            <span class="nav-icon" aria-hidden="true">🔍</span>
            <span class="metro-icon" aria-hidden="true">⌕</span>
            <span class="nav-label">Search</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="jobs">
            <span class="nav-icon" aria-hidden="true">⏳</span>
            <span class="metro-icon" aria-hidden="true">◷</span>
            <span class="nav-label">Jobs</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="feeds">
            <span class="nav-icon" aria-hidden="true">📡</span>
            <span class="metro-icon" aria-hidden="true">◉</span>
            <span class="nav-label">Feeds</span>
        </NavLink>
    </div>

    @* Adding an episode is members and up; the endpoint refuses viewers either way, so this
       only saves them a button that would fail. *@
    <AuthorizeView Policy="@Roles.MemberPolicy">
        <div class="nav-item">
            <NavLink class="nav-link" href="upload">
                <span class="nav-icon" aria-hidden="true">➕</span>
                <span class="metro-icon" aria-hidden="true">＋</span>
                <span class="nav-label">Add</span>
            </NavLink>
        </div>
    </AuthorizeView>

    <AuthorizeView Policy="@Roles.AdminPolicy">
        <div class="nav-item">
            <NavLink class="nav-link" href="users">
                <span class="nav-icon" aria-hidden="true">👥</span>
                <span class="metro-icon" aria-hidden="true">♟</span>
                <span class="nav-label">Users</span>
            </NavLink>
        </div>
    </AuthorizeView>
</nav>

@* WP7 reserves the application bar for no more than four common actions. Less frequent
   destinations live behind the ellipsis instead of shrinking every target to fit. *@
<nav class="nav metro-nav" aria-label="Application bar">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="metro-icon" aria-hidden="true">▦</span>
            <span class="nav-label">Library</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="search">
            <span class="metro-icon" aria-hidden="true">⌕</span>
            <span class="nav-label">Search</span>
        </NavLink>
    </div>

    <AuthorizeView Policy="@Roles.MemberPolicy">
        <div class="nav-item">
            <NavLink class="nav-link" href="upload">
                <span class="metro-icon" aria-hidden="true">＋</span>
                <span class="nav-label">Add</span>
            </NavLink>
        </div>
    </AuthorizeView>

    <details class="nav-item metro-overflow">
        <summary class="nav-link">
            <span class="metro-icon" aria-hidden="true">•••</span>
            <span class="nav-label">More</span>
        </summary>
        <div class="metro-menu">
            <NavLink href="jobs">jobs</NavLink>
            <NavLink href="feeds">feeds</NavLink>
            <AuthorizeView Policy="@Roles.AdminPolicy">
                <NavLink href="users">users</NavLink>
                <NavLink href="settings">settings</NavLink>
            </AuthorizeView>
        </div>
    </details>
</nav>
