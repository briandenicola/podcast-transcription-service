@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using PodcastTranscription.Web.Services.Security

<div class="desktop">
    <div class="window">
        <div class="title-bar">
            <span class="title-bar-icon" aria-hidden="true">🎙</span>
            <span class="title-bar-text">Podcast Transcription</span>
            <AuthorizeView Context="titleAuth">
                <Authorized>
                    <span class="pwa-title-user">
                        <span class="pwa-title-username">@titleAuth.User.Identity?.Name</span>
                        <AuthorizeView Policy="@Roles.AdminPolicy">
                            <span class="pwa-admin-icon" role="img" aria-label="Administrator"
                                  title="Administrator">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 3l7 3v5c0 4.7-2.8 8.2-7 10-4.2-1.8-7-5.3-7-10V6l7-3z"></path>
                                    <path d="M9 12l2 2 4-4"></path>
                                </svg>
                            </span>
                        </AuthorizeView>
                    </span>
                </Authorized>
            </AuthorizeView>
            @* Decorative only — there is no window manager behind them. *@
            <span class="title-bar-controls" aria-hidden="true">
                <span>_</span><span>□</span><span>✕</span>
            </span>
        </div>

        <div class="window-body">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row">
                    <AuthorizeView>
                        <Authorized>
                            <span class="signed-in-user">
                                <span class="signed-in-name">@context.User.Identity?.Name</span>
                                <span class="signed-in-role text-muted">@RoleOf(context.User)</span>
                            </span>
                            @* A form rather than a link: signing out changes state, so a GET
                               should not be able to trigger it. *@
                            <form method="post" action="/logout" class="m-0">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-sm">Sign out</button>
                            </form>
                        </Authorized>
                    </AuthorizeView>
                    @* Desktop-only; standalone navigation keeps Settings in the overflow menu. *@
                    <AuthorizeView Policy="@Roles.AdminPolicy">
                        <a href="/settings" class="btn btn-sm header-settings">Settings</a>
                    </AuthorizeView>
                </div>

                <article class="content">
                    @Body
                </article>
            </main>
        </div>

        @* Status, not configuration — the whisper endpoint and model live on the settings page. *@
        <div class="status-bar">
            <span class="status-bar-field">Ready</span>
            <span class="status-bar-field" id="w95-connection">Connecting…</span>
        </div>
    </div>

    <div class="taskbar">
        <a class="start-button" href="/">
            <span class="start-flag" aria-hidden="true"></span>
            Start
        </a>
        <span class="taskbar-spacer"></span>
        <span class="taskbar-tray">
            <span aria-hidden="true">🔊</span>
            <span id="w95-clock">--:--</span>
        </span>
    </div>
</div>

@code {
    /// <summary>
    /// The role shown beside the name. The configured admin has no database row, so this reads
    /// the claim rather than looking anything up.
    /// </summary>
    private static string RoleOf(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(Roles.Admin) ? "admin"
        : user.IsInRole(Roles.Member) ? "member"
        : "viewer";
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
