@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted small">@context.User.Identity?.Name</span>
                    @* A form rather than a link: signing out changes state, so it must not be
                       something a GET can trigger. *@
                    <form method="post" action="/logout" class="m-0">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link btn-sm p-0">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
            <a href="/settings" class="small">Settings</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
