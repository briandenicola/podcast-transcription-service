{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "Whisper": {
    "BaseUrl": "http://localhost:8080",
    "Model": "large-v3-turbo-q5_0",
    "Language": "auto",
    "Prompt": null,
    "Temperature": 0.0,
    "RequestTimeoutMinutes": 120
  },

  "Storage": {
    "DataPath": "var/data",
    "MediaPath": "var/media",
    "MaxUploadMb": 2048
  },

  "MediaTools": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "YtDlpPath": "yt-dlp"
  }
}
