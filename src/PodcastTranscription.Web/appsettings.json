{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "Whisper": {
    "BaseUrl": "http://localhost:8080",
    "Model": "large-v3-turbo-q5_0",
    "Language": "auto",
    "Prompt": null,
    "Temperature": 0.0,
    "RequestTimeoutMinutes": 120
  },

  "Transcription": {
    "WorkerCount": 1,
    "ChunkSeconds": 600,
    "SilenceSearchWindowSeconds": 90,
    "SilenceNoiseDb": -30,
    "SilenceMinDurationSeconds": 0.5,
    "WordTimestamps": true,
    "WordGapMs": 700,
    "MaxSegmentChars": 200,
    "MaxAttempts": 3,
    "RetryBaseSeconds": 30,
    "PollSeconds": 5
  },

  "Ollama": {
    "Enabled": false,
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1:8b",
    "AutoSummarize": true,
    "RequestTimeoutMinutes": 30,
    "Temperature": 0.2,
    "ContextTokens": 8192,
    "MaxOutputTokens": 2048,
    "Think": false,
    "MaxWindowChars": 12000,
    "ExtraInstructions": null
  },

  "Ingest": {
    "PollFeeds": true,
    "PollIntervalMinutes": 60,
    "InitialPollDelaySeconds": 60,
    "QueueExistingItemsOnSubscribe": false,
    "MaxItemsPerPoll": 50,
    "DefaultBackfillCount": 5,
    "DownloadTimeoutMinutes": 60,
    "FeedTimeoutSeconds": 30
  },

  "Auth": {
    "Enabled": true,
    "Username": "admin",
    "PasswordHash": null,
    "Password": null,
    "ApiKey": null,
    "SessionDays": 30
  },

  "Maintenance": {
    "Enabled": true,
    "RunAt": "03:30",
    "DeleteSourceAfterTranscription": false,
    "DeleteSourceAfterDays": 30,
    "KeepPreparedWav": true,
    "BackupDatabase": true,
    "BackupsToKeep": 7
  },

  "Storage": {
    "DataPath": "var/data",
    "MediaPath": "var/media",
    "MaxUploadMb": 2048
  },

  "MediaTools": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "YtDlpPath": "yt-dlp"
  }
}
